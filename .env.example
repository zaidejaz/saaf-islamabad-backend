DB_HOST=localhost
DB_PORT=5432
DB_USER=saaf_user
DB_PASSWORD=saaf_secret
DB_NAME=saaf_islamabad
DB_SSLMODE=disable

JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRY_HOURS=72

SERVER_PORT=8080
GIN_MODE=release
BASE_URL=https://api.yourdomain.com

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@saafislamabad.pk
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Twilio SMS OTP ────────────────────────────────────
# Trial: https://console.twilio.com — verify recipient numbers in the trial console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OTP_DAILY_LIMIT=100
OTP_PER_PHONE_DAILY=10

# AI image classification (Groq free-tier vision by default)
# Get a key at https://console.groq.com/keys
AI_ENABLED=true
AI_PROVIDER=groq
# Swap models without code changes. Free vision options on Groq:
#   meta-llama/llama-4-scout-17b-16e-instruct  (default)
#   qwen/qwen3.6-27b
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
# Alias if you prefer a provider-agnostic name:
# AI_API_KEY=
AI_TIMEOUT_SECS=8
